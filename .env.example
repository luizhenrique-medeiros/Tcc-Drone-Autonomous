APP_ENV=development
APP_NAME=drone-delivery
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
AUTO_CREATE_SCHEMA=false

# Bind seguro por padrão. Use 0.0.0.0 somente para uma LAN confiável e siga
# docs/LOCAL_NETWORK_SETUP.md antes de expor a API ou o painel.
DATABASE_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
ADMIN_BIND_ADDRESS=127.0.0.1

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=drone_delivery
DATABASE_USER=drone_user
DATABASE_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://drone_user:change_me@db:5432/drone_delivery

JWT_SECRET=change_me_with_at_least_32_characters
JWT_EXPIRE_MINUTES=60
ADMIN_INITIAL_EMAIL=admin@example.local
ADMIN_INITIAL_PASSWORD=12345678

MAP_PROVIDER=maptiler
MAPTILER_STYLE_URL=https://api.maptiler.com/maps/hybrid-v4/style.json
MAPTILER_WEB_API_KEY=
MAPTILER_ANDROID_API_KEY=
MAPTILER_SERVER_API_KEY=
# Vazio permite pesquisa mundial; cobertura é validada somente no domínio.
MAPS_SEARCH_COUNTRY=
MAPS_DEFAULT_LATITUDE=-23.1175
MAPS_DEFAULT_LONGITUDE=-46.5502
BASE_LATITUDE=-23.1175
BASE_LONGITUDE=-46.5502

GATEWAY_API_KEY=change_me_gateway_key
GATEWAY_ID=dev-gateway-01
MAVLINK_MODE=simulation
# `direct`: COM7. `mission_planner_forward`: usa MAVLINK_FORWARD_CONNECTION.
# Em `simulation` estes endpoints físicos não são abertos.
MAVLINK_CONNECTION=COM7
MAVLINK_FORWARD_CONNECTION=udpin:127.0.0.1:14551
MAVLINK_BAUD=57600
MAVLINK_SOURCE_SYSTEM_ID=254
MAVLINK_SOURCE_COMPONENT_ID=190
MAVLINK_TARGET_SYSTEM_ID=
MAVLINK_TARGET_COMPONENT_ID=
MAVLINK_DIALECT=ardupilotmega
MAVLINK2_ENABLED=true
MAVLINK_RECONNECT_INITIAL_SECONDS=1
MAVLINK_RECONNECT_MAX_SECONDS=10
MAVLINK_TELEMETRY_STALE_SECONDS=5
GATEWAY_COMMAND_MAX_AGE_SECONDS=60
MAVLINK_UDP_BIND_ADDRESS=127.0.0.1
REAL_HARDWARE_CONFIRMATION_REQUIRED=true
REAL_HARDWARE_ACKNOWLEDGED=false
# As três etapas são independentes e ficam bloqueadas por padrão.
ALLOW_MISSION_UPLOAD=false
ALLOW_FLIGHT_COMMANDS=false
ALLOW_MISSION_START=false

DEFAULT_TAKEOFF_ALTITUDE_M=10
# Limite operacional do gateway; não restringe salvar ou confirmar pedidos.
MAX_MISSION_DISTANCE_M=500
MIN_BATTERY_PERCENT=40
MIN_GPS_SATELLITES=10
HEARTBEAT_TIMEOUT_SECONDS=10
MISSION_COMMAND_TIMEOUT_SECONDS=15
FLIGHT_AUTHORIZATION_TTL_SECONDS=300
TELEMETRY_PERSIST_INTERVAL_SECONDS=2

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=
VITE_DEMO_MODE=false
# Perfis do Flutter: local_web, android_emulator, android_physical_device,
# demo_network e hosted. A URL abaixo é apenas do emulador Android.
MOBILE_APP_ENVIRONMENT=android_emulator
MOBILE_API_BASE_URL=http://10.0.2.2:8000
MOBILE_ALLOW_INSECURE_LAN_HTTP=false
FLUTTER_WEB_PORT=5174
