# URL pública do backend. Não inclua barra no final.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# O modo demo é local, explícito e nunca envia comandos ao backend ou veículo.
VITE_DEMO_MODE=false

# Chave de navegador restrita por origem e apenas às APIs de mapa necessárias.
# Sem chave, o painel mostra o fallback coordenado e continua operacional.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=

# WebSocket administrativo. Se vazio, deriva da URL da API.
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
