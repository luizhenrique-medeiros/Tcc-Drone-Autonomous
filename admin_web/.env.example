# URL pública do backend. Não inclua barra no final.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# O modo demo é local, explícito e nunca envia comandos ao backend ou veículo.
VITE_DEMO_MODE=false

# Chave pública web do MapTiler, restrita aos domínios autorizados no painel.
# Sem chave, o painel mostra o fallback coordenado e não simula um mapa carregado.
MAPTILER_WEB_API_KEY=

# Estilo vetorial híbrido. Mantenha a chave separada na variável acima.
MAPTILER_STYLE_URL=https://api.maptiler.com/maps/hybrid-v4/style.json

# WebSocket administrativo. Se vazio, deriva da URL da API.
VITE_WS_BASE_URL=
